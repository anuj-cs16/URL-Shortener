PORT=8080
MONGO_URI=your_mongodb_connection_string_here
BASE_URL=http://localhost:8080
NODE_ENV=development

# JWT Settings
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Analytics Settings
ANALYTICS_ENABLED=true

# Email Notification Settings
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=QuickLink <your_email@gmail.com>
WEEKLY_REPORT_CRON=0 9 * * 1
NOTIFICATION_EMAIL_ENABLED=true

# Security Settings
TWO_FACTOR_APP_NAME=QuickLink
ENCRYPTION_KEY=your_32_char_encryption_key
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30
SUSPICIOUS_LOGIN_THRESHOLD=3
SECURITY_EMAIL_ENABLED=true

# Cache and Compression Configurations
CACHE_TTL_SECONDS=300
ENABLE_COMPRESSION=true
ENABLE_CACHE=true

# Stripe Subscriptions Integration
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_FREE_PRICE_ID=price_free
STRIPE_PRO_PRICE_ID=price_your_pro_id
STRIPE_BUSINESS_PRICE_ID=price_your_biz_id


