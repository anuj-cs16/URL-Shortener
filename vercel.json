{
  "version": 2,
  "installCommand": "cd quicklink && npm install --legacy-peer-deps",
  "buildCommand": "cd quicklink && npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/quicklink/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/quicklink/api/index.js"
    }
  ]
}
